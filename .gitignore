# Default to ignoring new top-level content. Explicitly unignore the project
# source, curated benchmark adapter, curated data, and documentation below.
*

# Repository metadata and project docs
!.gitignore
!readme.md
!intro.md
!requirements.txt
!run.sh
!bench.png

docs/ref/**

# Core VESTA code, offline importers, and curated/source data
!src/
!src/**
!scripts/
!scripts/**
!data/
!data/**
!configs/
!configs/**

# Do not commit private model/eval configs. These currently contain API keys.
!configs/llm/*.yaml
!configs/eval_configs/*.yaml
!configs/llm/*.example.yaml
!configs/eval_configs/*.example.yaml

# Local materials kept outside the curated source snapshots
# Upstream/raw benchmark repositories
external/
# Local benchmark prototypes and simulations
experiments/
# Human-authored mapping sheets and reference material
references/

# Runtime working files, experiment outputs, and local caches
runtime/
outputs/
old/

# Python/cache artifacts
**/__pycache__/
**/*.py[cod]
*.pyc

# Virtual environments and local environment files
/.venv/
/venv/
/env/
.env
.env.*

# IDE and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Temporary Office files
~$*
run.sh
